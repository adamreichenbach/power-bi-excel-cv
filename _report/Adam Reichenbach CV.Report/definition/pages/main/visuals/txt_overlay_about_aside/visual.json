                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt",
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "color": "#242424"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•   One Excel workbook is the single source of truth — one structured table per entity.",
                    "textStyle": {
                      "fontSize": "14pt",
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "color": "#616161"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•   A real star schema: dimensions, entities, content tables and bridge tables.",
                    "textStyle": {
                      "fontSize": "14pt",
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "color": "#616161"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•   DAX measures drive the formula bar, the sheet content and every state label.",
                    "textStyle": {
                      "fontSize": "14pt",
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "color": "#616161"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•   Navigation runs on bookmarks; ribbon state is deliberately independent of it.",
                    "textStyle": {
                      "fontSize": "14pt",
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "color": "#616161"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•   Perspective regroups Experience and Projects without using a single bookmark.",
                    "textStyle": {
                      "fontSize": "14pt",
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "color": "#616161"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•   The whole report is authored as TMDL and PBIR files on disk, so it diffs like code.",
                    "textStyle": {
                      "fontSize": "14pt",
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "color": "#616161"
                    }
                  }
                ]
              }
            ]
