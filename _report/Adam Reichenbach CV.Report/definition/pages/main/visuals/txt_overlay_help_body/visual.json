    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "If anything gets stuck",
                    "textStyle": {
                      "fontSize": "16pt",
                      "fontFamily": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
                      "color": "#242424"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt",
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "color": "#242424"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•   Nothing you do here is saved: reload the page and the CV returns to exactly how it started.",
                    "textStyle": {
                      "fontSize": "14pt",
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "color": "#242424"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt",
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "color": "#242424"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Getting around",
                    "textStyle": {
                      "fontSize": "16pt",
                      "fontFamily": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
                      "color": "#242424"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt",
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "color": "#242424"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•   Click a sheet tab at the bottom to move between the seven sections of the CV, just like switching worksheets.",
                    "textStyle": {
                      "fontSize": "14pt",
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "color": "#242424"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•   Click the File tab to open this overlay. Click the back arrow at the top left to close it and return to where you were, with your sheet, filters and ribbon settings preserved.",
                    "textStyle": {
                      "fontSize": "14pt",
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "color": "#242424"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•   Click a role or a project to open its profile in the panel on the right: period, skills, tools and a highlight.",
                    "textStyle": {
                      "fontSize": "14pt",
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "color": "#242424"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt",
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "color": "#242424"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The Home ribbon",
                    "textStyle": {
                      "fontSize": "16pt",
                      "fontFamily": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
                      "color": "#242424"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt",
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "color": "#242424"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•   View switches between Story and List: only the wording changes, never the grouping or what is shown.",
                    "textStyle": {
                      "fontSize": "14pt",
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "color": "#242424"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•   Detail Level switches between Compact and Standard: the same content at two densities.",
                    "textStyle": {
                      "fontSize": "14pt",
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "color": "#242424"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•   Perspective regroups Experience and Projects by Timeline, Skills or Industries.",
                    "textStyle": {
                      "fontSize": "14pt",
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "color": "#242424"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•   Filters narrow the content by Function, Industry, Skill or Tool.",
                    "textStyle": {
                      "fontSize": "14pt",
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "color": "#242424"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•   Commands grey out on sheets where they do not apply, the same way Excel greys commands it cannot run.",
                    "textStyle": {
                      "fontSize": "14pt",
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "color": "#242424"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt",
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "color": "#242424"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The formula bar",
                    "textStyle": {
                      "fontSize": "16pt",
                      "fontFamily": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
                      "color": "#242424"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt",
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "color": "#242424"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•   It is read-only. It writes out the current sheet as a genuine Excel formula — view mode, detail level, perspective and any active filter are all in it, so a filtered sheet never reads as the whole story.",
                    "textStyle": {
                      "fontSize": "14pt",
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "color": "#242424"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•   Select a row and the formula becomes that item’s lookup, while the name box shows its cell.",
                    "textStyle": {
                      "fontSize": "14pt",
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "color": "#242424"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt",
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "color": "#242424"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The 1 to 7 scales",
                    "textStyle": {
                      "fontSize": "16pt",
                      "fontFamily": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
                      "color": "#242424"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt",
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "color": "#242424"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•   The radar in a role or project profile shows how central each skill was to that piece of work — relevance, not ability.",
                    "textStyle": {
                      "fontSize": "14pt",
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "color": "#242424"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•   The number beside a tool or skill, like 7/7, shows my ability: my own rating of my current level of proficiency.",
                    "textStyle": {
                      "fontSize": "14pt",
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "color": "#242424"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•   Where I have not rated something, it stays blank rather than guessed.",
                    "textStyle": {
                      "fontSize": "14pt",
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "color": "#242424"
                    }
                  }
                ]
              }
            ]
          }
