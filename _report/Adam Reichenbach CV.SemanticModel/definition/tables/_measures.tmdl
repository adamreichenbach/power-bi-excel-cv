	measure contact_email_primary_url =
			VAR _v =
			    CALCULATE(
			        MAX( tbl_contact_methods[method_value] ),
			        REMOVEFILTERS( tbl_contact_methods ),
			        tbl_contact_methods[method_type] = "email",
			        tbl_contact_methods[is_primary] = TRUE()
			    )
			RETURN IF( NOT ISBLANK( _v ), "mailto:" & _v )
		lineageTag: da2f233f-e647-48a6-9907-50f3bfefb0f8

	measure contact_email_secondary_url =
			VAR _t =
			    CALCULATETABLE(
			        tbl_contact_methods,
			        REMOVEFILTERS( tbl_contact_methods ),
			        tbl_contact_methods[method_type] = "email",
			        tbl_contact_methods[is_primary] = FALSE()
			    )
			VAR _v = MAXX( TOPN( 1, _t, tbl_contact_methods[display_order], ASC ), tbl_contact_methods[method_value] )
			RETURN IF( NOT ISBLANK( _v ), "mailto:" & _v )
		lineageTag: b620bcdf-a82a-48d4-8af1-4383a219b83a

	measure contact_linkedin_url =
			CALCULATE(
			    MAX( tbl_contact_methods[method_value] ),
			    REMOVEFILTERS( tbl_contact_methods ),
			    tbl_contact_methods[method_type] = "linkedin"
			)
		lineageTag: 5123dd05-1b77-4fbe-835e-a912826c0117

