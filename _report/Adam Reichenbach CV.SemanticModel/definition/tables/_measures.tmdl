	measure prj_period_display =
			VAR _from = SELECTEDVALUE( tbl_projects[from_month_code] )
			VAR _to   = SELECTEDVALUE( tbl_projects[to_month_code] )
			VAR _fromText =
			    FORMAT( DATE( INT( _from / 100 ), MOD( _from, 100 ), 1 ), "MMM yyyy" )
			VAR _toText =
			    IF(
			        _to = 999912,
			        "present",
			        FORMAT( DATE( INT( _to / 100 ), MOD( _to, 100 ), 1 ), "MMM yyyy" )
			    )
			RETURN
			    IF( ISBLANK( _from ), BLANK(), _fromText & " - " & _toText )
		lineageTag: e7cbe4be-902a-42cc-bc33-1ea3ce509757

	measure prj_identity =
			VAR _employer = CALCULATE( SELECTEDVALUE( tbl_employers[employer_name] ),
			                           TREATAS( VALUES( tbl_projects[employer_id] ), tbl_employers[employer_id] ) )
			VAR _name = SELECTEDVALUE( tbl_projects[project_name] )
			RETURN
			    IF( ISBLANK( _name ), BLANK(),
			        IF( ISBLANK( _employer ), _name, _employer & "  -  " & _name ) )
		lineageTag: b7d2fe6c-0ddd-49ec-b542-f18a2b224be8

	measure prj_key_facts =
			VAR _row_skill = SELECTEDVALUE( tbl_project_perspective_rows[skill_id] )
			VAR _skill_row_dropped =
			    NOT ISBLANK( _row_skill )
			        && ISFILTERED( tbl_skills[skill_name] )
			        && NOT _row_skill IN VALUES( tbl_skills[skill_id] )
			RETURN
			IF(
			    _skill_row_dropped,
			    BLANK(),
			    CALCULATE(
			        VAR _perspective = SELECTEDVALUE( tbl_perspectives[perspective_id] )
			        VAR _period      = SELECTEDVALUE( tbl_project_perspective_rows[project_period] )
			        VAR _industry    = SELECTEDVALUE( tbl_project_perspective_rows[project_industry_name] )
			        VAR _function    = SELECTEDVALUE( tbl_project_perspective_rows[project_function_name] )
			        VAR _industry_is_the_grouping = _perspective = 3
			        RETURN
			            IF(
			                ISBLANK( _period ),
			                BLANK(),
			                _period
			                    & IF(
			                        _industry_is_the_grouping || ISBLANK( _industry ),
			                        "",
			                        "  ·  " & _industry
			                      )
			                    & IF( ISBLANK( _function ), "", "  ·  " & _function )
			            ),
			        CROSSFILTER( tbl_project_skill[project_id], tbl_projects[project_id], Both ),
			        CROSSFILTER( tbl_project_tool[project_id],  tbl_projects[project_id], Both )
			    )
			)
		lineageTag: 922a84ed-3d59-4b9d-bd99-ea473b1d0e6c

	measure prj_body_text =
			VAR _view   = SELECTEDVALUE( tbl_view_modes[mode], "Story" )
			VAR _detail = SELECTEDVALUE( tbl_detail_levels[mode], "Standard" )
			VAR _row_skill = SELECTEDVALUE( tbl_project_perspective_rows[skill_id] )
			VAR _skill_row_dropped =
			    NOT ISBLANK( _row_skill )
			        && ISFILTERED( tbl_skills[skill_name] )
			        && NOT _row_skill IN VALUES( tbl_skills[skill_id] )
			RETURN
			IF(
			    _skill_row_dropped,
			    BLANK(),
			    CALCULATE(
			        CALCULATE(
			            SELECTEDVALUE( tbl_project_content[text] ),
			            TREATAS( VALUES( tbl_project_perspective_rows[project_id] ), tbl_projects[project_id] ),
			            tbl_project_content[view] = _view,
			            tbl_project_content[detail_level] = _detail
			        ),
			        CROSSFILTER( tbl_project_skill[project_id], tbl_projects[project_id], Both ),
			        CROSSFILTER( tbl_project_tool[project_id],  tbl_projects[project_id], Both )
			    )
			)
		lineageTag: 76e59d90-49d8-4dda-8675-b1c35bc38b1b

	measure prj_visible_count =
			COALESCE(
			    CALCULATE(
			        DISTINCTCOUNT( tbl_project_perspective_rows[project_id] ),
			        CROSSFILTER( tbl_project_skill[project_id], tbl_projects[project_id], Both ),
			        CROSSFILTER( tbl_project_tool[project_id],  tbl_projects[project_id], Both )
			    ),
			    0
			)
		formatString: 0
		lineageTag: 60ed5f5d-c586-47ad-b93b-449c0921e9f5

	measure prj_total_count =
			CALCULATE(
			    DISTINCTCOUNT( tbl_project_perspective_rows[project_id] ),
			    REMOVEFILTERS( tbl_project_perspective_rows ),
			    REMOVEFILTERS( tbl_perspectives ),
			    REMOVEFILTERS( tbl_projects ),
			    REMOVEFILTERS( tbl_project_skill ),
			    REMOVEFILTERS( tbl_project_tool ),
			    REMOVEFILTERS( tbl_skills ),
			    REMOVEFILTERS( tbl_tools ),
			    REMOVEFILTERS( tbl_industries ),
			    REMOVEFILTERS( tbl_functions )
			)
		formatString: 0
		lineageTag: ad67acb8-1c37-48a8-98b6-b9c9eba75279

	measure prj_count_label =
