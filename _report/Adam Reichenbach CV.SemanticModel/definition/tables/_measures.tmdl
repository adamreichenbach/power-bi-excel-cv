	measure dbg_selected_view_mode = SELECTEDVALUE( tbl_view_modes[mode], "(none)" )
		lineageTag: a9df775b-cab6-4b45-89ac-be21e2e4ab82

	measure fbar_sheet_code =
			SWITCH(
			    SELECTEDVALUE( tbl_sheet_tabs[sheet_tab_id], 1 ),
			    1, "EXEC",
			    2, "EXP",
			    3, "PRJ",
			    4, "TECH",
			    7, "SKL",
			    5, "EDU",
			    6, "ADD",
			    "?"
			)
		lineageTag: e211916a-3f39-4c48-8eb0-bc81c911bc98

	measure fbar_cell_ref =
			VAR _sheet = SELECTEDVALUE( tbl_sheet_tabs[sheet_tab_id], 1 )
			VAR _default =
			    SWITCH( _sheet, 1, "A1", 2, "B4", 3, "C4", 4, "C2", 5, "D1", 6, "E1", 7, "B2", "?" )
			VAR _item = NOT ISBLANK( [fbar_selected_name] )
			VAR _pg = SELECTEDVALUE( tbl_project_perspective_rows[group_label] )
			VAR _pk = SELECTEDVALUE( tbl_project_perspective_rows[project_sort_key] )
			VAR _prows =
			    CALCULATETABLE(
			        FILTER(
			            SUMMARIZE( tbl_project_perspective_rows, tbl_project_perspective_rows[group_label], tbl_project_perspective_rows[project_sort_key] ),
			            NOT ISBLANK( [prj_key_facts] )
			        ),
			        REMOVEFILTERS( tbl_project_perspective_rows[group_label], tbl_project_perspective_rows[project_identity], tbl_project_perspective_rows[project_sort_key] )
			    )
			VAR _prj_item_row =
			    COUNTROWS(
			        FILTER(
			            _prows,
			            tbl_project_perspective_rows[group_label] < _pg
			                || ( tbl_project_perspective_rows[group_label] = _pg && tbl_project_perspective_rows[project_sort_key] < _pk )
			        )
			    ) + 2
			VAR _prj_group_row = COUNTROWS( FILTER( _prows, tbl_project_perspective_rows[group_label] < _pg ) ) + 2
			VAR _prj_group =
			    _sheet = 3
			        && NOT ISFILTERED( tbl_project_perspective_rows[project_identity] )
			        && ISFILTERED( tbl_project_perspective_rows[group_label] )
			        && HASONEVALUE( tbl_project_perspective_rows[group_label] )
			VAR _rg = SELECTEDVALUE( tbl_role_perspective_rows[group_label] )
			VAR _rf = SELECTEDVALUE( tbl_role_perspective_rows[role_from_month_code] )
			VAR _ri = SELECTEDVALUE( tbl_role_perspective_rows[role_id] )
			VAR _rrows =
			    CALCULATETABLE(
			        FILTER(
			            SUMMARIZE( tbl_role_perspective_rows, tbl_role_perspective_rows[group_label], tbl_role_perspective_rows[role_from_month_code], tbl_role_perspective_rows[role_id] ),
			            NOT ISBLANK( [exp_key_facts] )
			        ),
			        REMOVEFILTERS( tbl_role_perspective_rows[group_label], tbl_role_perspective_rows[role_identity], tbl_role_perspective_rows[role_from_month_code], tbl_role_perspective_rows[role_id] )
			    )
			VAR _role_item_row =
			    COUNTROWS(
			        FILTER(
			            _rrows,
			            tbl_role_perspective_rows[group_label] < _rg
			                || (
			                    tbl_role_perspective_rows[group_label] = _rg
			                        && (
			                            tbl_role_perspective_rows[role_from_month_code] < _rf
			                                || ( tbl_role_perspective_rows[role_from_month_code] = _rf && tbl_role_perspective_rows[role_id] < _ri )
			                        )
			                )
			        )
			    ) + 2
			VAR _role_group_row = COUNTROWS( FILTER( _rrows, tbl_role_perspective_rows[group_label] < _rg ) ) + 2
			VAR _role_group =
			    _sheet = 2
			        && NOT ISFILTERED( tbl_role_perspective_rows[role_identity] )
			        && ISFILTERED( tbl_role_perspective_rows[group_label] )
			        && HASONEVALUE( tbl_role_perspective_rows[group_label] )
			VAR _tk = SELECTEDVALUE( tbl_tools[tool_sort_key] )
			VAR _tool_row =
			    CALCULATE(
			        COUNTROWS( FILTER( VALUES( tbl_tools[tool_sort_key] ), tbl_tools[tool_sort_key] < _tk && [tech_in_scope] = 1 ) ),
			        REMOVEFILTERS( tbl_tools[tool_row_label], tbl_tools[tool_sort_key] )
			    ) + 2
			VAR _sk = SELECTEDVALUE( tbl_skills[skill_sort_key] )
			VAR _skill_row =
			    CALCULATE(
			        COUNTROWS( FILTER( VALUES( tbl_skills[skill_sort_key] ), tbl_skills[skill_sort_key] < _sk && [skills_in_scope] = 1 ) ),
			        REMOVEFILTERS( tbl_skills[skill_row_label], tbl_skills[skill_sort_key] )
			    ) + 2
			RETURN
			    SWITCH(
			        TRUE(),
			        _sheet = 3 && _item, "B" & _prj_item_row,
			        _prj_group, "A" & _prj_group_row,
			        _sheet = 2 && _item, "B" & _role_item_row,
			        _role_group, "A" & _role_group_row,
			        _sheet = 4 && _item, "A" & _tool_row,
			        _sheet = 7 && _item, "A" & _skill_row,
			        _default
			    )
		lineageTag: dd887a4a-87d3-45c0-acc8-e081b0017c6b

	measure fbar_name_box = [fbar_cell_ref]
		lineageTag: 09df27f8-c5a2-4c01-abdd-2b17b4a8d711

	measure fbar_formula =
			VAR _sheet  = SELECTEDVALUE( tbl_sheet_tabs[sheet_tab_id], 1 )
			VAR _view   = SELECTEDVALUE( tbl_view_modes[mode], "Story" )
			VAR _detail = SELECTEDVALUE( tbl_detail_levels[mode], "Standard" )
			VAR _col    = _view & " " & _detail
			VAR _group  =
			    SWITCH(
			        SELECTEDVALUE( tbl_perspectives[perspective_name], "Timeline" ),
			        "Skills", "Skill",
			        "Industries", "Industry",
			        "Period"
			    )
			VAR _filter = [fbar_filter_template]
			VAR _has_filter = LEN( _filter ) > 0
			VAR _q = """"
			VAR _name = [fbar_selected_name]
			VAR _lit = _q & SUBSTITUTE( _name, _q, _q & _q ) & _q
			VAR _groupby =
			    "=GROUPBY({T}[" & _group & "], {T}[" & _col & "], CONCAT, , 0"
			        & IF( _has_filter, ", , " & _filter, "" )
			        & ")"
			RETURN
			    SWITCH(
			        _sheet,
			        1, "=XLOOKUP(" & _q & _detail & _q & ", Summary[Detail], Summary[Text])",
			        2,
			            IF(
			                NOT ISBLANK( _name ),
			                "=XLOOKUP(" & _lit & ", Roles[Role], Roles[" & _col & "])",
			                SUBSTITUTE( _groupby, "{T}", "Roles" )
			            ),
			        3,
			            IF(
			                NOT ISBLANK( _name ),
			                "=XLOOKUP(" & _lit & ", Projects[Project], Projects[" & _col & "])",
			                SUBSTITUTE( _groupby, "{T}", "Projects" )
			            ),
			        4,
			            IF(
			                NOT ISBLANK( _name ),
			                "=XLOOKUP(" & _lit & ", Tools[Tool], Tools[" & _col & "])",
			                "=SORT("
			                    & IF(
			                        _has_filter,
			                        "FILTER(Tools[[Tool]:[" & _col & "]], " & SUBSTITUTE( _filter, "{T}", "Tools" ) & ")",
			                        "Tools[[Tool]:[" & _col & "]]"
			                    )
			                    & ", 3, -1)"
			            ),
			        5, "=SORTBY(Education[[Institution]:[" & _view & "]], Education[From], -1)",
			        6, "=SORTBY(Additional, Additional[Highlight], -1, Additional[Section Order], 1, Additional[Year], -1)",
			        7,
			            IF(
			                NOT ISBLANK( _name ),
			                "=XLOOKUP(" & _lit & ", Skills[Skill], Skills[Proficiency])",
			                "=SORT("
			                    & IF( _has_filter, "FILTER(Skills, " & SUBSTITUTE( _filter, "{T}", "Skills" ) & ")", "Skills" )
			                    & ", {2,3}, {-1,-1})"
			            )
			    )
		lineageTag: fe074ef2-bb50-483a-818c-c30ee058fa78

	measure window_title = SELECTEDVALUE( tbl_profile[full_name] ) & " - " & SELECTEDVALUE( tbl_profile[professional_title] ) & " CV.pbix - Excel"
