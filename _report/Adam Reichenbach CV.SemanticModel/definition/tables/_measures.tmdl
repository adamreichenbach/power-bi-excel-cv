	measure sel_entity =
			VAR _p = [sel_project_id]
			VAR _r = [sel_role_id]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISFILTERED( tbl_role_perspective_rows[role_identity] ), "role",
			        ISFILTERED( tbl_project_perspective_rows[project_identity] ), "project",
			        HASONEVALUE( tbl_project_perspective_rows[project_id] ), "project",
			        HASONEVALUE( tbl_role_perspective_rows[role_id] ), "role",
			        NOT ISBLANK( _r ) && ISBLANK( _p ), "role",
			        NOT ISBLANK( _p ) && ISBLANK( _r ), "project",
			        BLANK()
			    )
		lineageTag: 86354b2a-a658-4545-81ca-fec8423d9af5

	measure sel_override_text =
			VAR _r = [sel_role_id]
			RETURN
			    IF(
			        [sel_entity] = "role",
			        CALCULATE( SELECTEDVALUE( tbl_roles[tooltip_override_text] ), REMOVEFILTERS( tbl_roles ), tbl_roles[role_id] = _r )
			    )
		lineageTag: 2b2419e9-6dbd-4651-a516-9c26c5312432

	measure sel_title =
			VAR _p = [sel_project_id]
			VAR _r = [sel_role_id]
			RETURN
			    SWITCH(
			        [sel_entity],
			        "project", CALCULATE( SELECTEDVALUE( tbl_projects[project_name] ), REMOVEFILTERS( tbl_projects ), tbl_projects[project_id] = _p ),
			        "role",    CALCULATE( SELECTEDVALUE( tbl_roles[role_title] ),      REMOVEFILTERS( tbl_roles ),    tbl_roles[role_id] = _r )
			    )
		lineageTag: 24249df6-2c85-4ccf-9e02-ec691783fe47

	measure sel_employer =
			VAR _p = [sel_project_id]
			VAR _r = [sel_role_id]
			VAR _eid =
			    SWITCH(
			        [sel_entity],
			        "project", CALCULATE( SELECTEDVALUE( tbl_projects[employer_id] ), REMOVEFILTERS( tbl_projects ), tbl_projects[project_id] = _p ),
			        "role",    CALCULATE( SELECTEDVALUE( tbl_roles[employer_id] ),    REMOVEFILTERS( tbl_roles ),    tbl_roles[role_id] = _r )
			    )
			RETURN
			    CALCULATE( SELECTEDVALUE( tbl_employers[employer_name] ), REMOVEFILTERS( tbl_employers ), tbl_employers[employer_id] = _eid )
		lineageTag: 7d4c4ff4-ba60-444d-9d8c-4ee1a219d3dd

	measure sel_period =
			VAR _e = [sel_entity]
			VAR _p = [sel_project_id]
			VAR _r = [sel_role_id]
			VAR _from =
			    SWITCH(
			        _e,
			        "project", CALCULATE( SELECTEDVALUE( tbl_projects[from_month_code] ), REMOVEFILTERS( tbl_projects ), tbl_projects[project_id] = _p ),
			        "role",    CALCULATE( SELECTEDVALUE( tbl_roles[from_month_code] ),    REMOVEFILTERS( tbl_roles ),    tbl_roles[role_id] = _r )
			    )
			VAR _to =
			    SWITCH(
			        _e,
			        "project", CALCULATE( SELECTEDVALUE( tbl_projects[to_month_code] ), REMOVEFILTERS( tbl_projects ), tbl_projects[project_id] = _p ),
			        "role",    CALCULATE( SELECTEDVALUE( tbl_roles[to_month_code] ),    REMOVEFILTERS( tbl_roles ),    tbl_roles[role_id] = _r )
			    )
			VAR _fromText = FORMAT( DATE( INT( _from / 100 ), MOD( _from, 100 ), 1 ), "MMM yyyy" )
			VAR _toText =
			    IF( _to = 999912, "present", FORMAT( DATE( INT( _to / 100 ), MOD( _to, 100 ), 1 ), "MMM yyyy" ) )
			VAR _emp = [sel_employer]
			RETURN
			    IF(
			        ISBLANK( _from ),
			        "",
			        IF( ISBLANK( _emp ), "", _emp & "   ·   " ) & _fromText & " – " & _toText
			    )
		lineageTag: 7a6a69e7-6b03-4098-a191-9877e70d1ea2

	measure sel_chips =
			VAR _e = [sel_entity]
			VAR _p = [sel_project_id]
			VAR _r = [sel_role_id]
			VAR _iid =
			    SWITCH(
			        _e,
			        "project",
			            CALCULATE( SELECTEDVALUE( tbl_projects[industry_id] ), REMOVEFILTERS( tbl_projects ), tbl_projects[project_id] = _p ),
			        "role",
			            VAR _eid = CALCULATE( SELECTEDVALUE( tbl_roles[employer_id] ), REMOVEFILTERS( tbl_roles ), tbl_roles[role_id] = _r )
			            RETURN CALCULATE( SELECTEDVALUE( tbl_employers[industry_id] ), REMOVEFILTERS( tbl_employers ), tbl_employers[employer_id] = _eid )
			    )
			VAR _industry =
			    CALCULATE( SELECTEDVALUE( tbl_industries[industry_name] ), REMOVEFILTERS( tbl_industries ), tbl_industries[industry_id] = _iid )
			VAR _rtid =
			    IF(
			        _e = "role",
			        CALCULATE( SELECTEDVALUE( tbl_roles[role_type_id] ), REMOVEFILTERS( tbl_roles ), tbl_roles[role_id] = _r ),
			        2
			    )
			VAR _type =
			    CALCULATE( SELECTEDVALUE( tbl_role_types[role_type_name] ), REMOVEFILTERS( tbl_role_types ), tbl_role_types[role_type_id] = _rtid )
			VAR _location =
			    IF(
			        _e = "role",
			        CALCULATE( SELECTEDVALUE( tbl_roles[location] ), REMOVEFILTERS( tbl_roles ), tbl_roles[role_id] = _r )
			    )
			VAR _parts =
			    IF( ISBLANK( _industry ), "", "   ·   " & _industry )
			        & IF( ISBLANK( _type ), "", "   ·   " & _type )
			        & IF( ISBLANK( _location ), "", "   ·   " & _location )
			RETURN
			    IF(
			        NOT ISBLANK( [sel_override_text] ) || ISBLANK( _e ) || LEN( _parts ) = 0,
			        "",
			        MID( _parts, 8, LEN( _parts ) )
			    )
		lineageTag: a2fea87f-5998-4612-b567-151fad700bc8

	measure sel_tools =
			VAR _e = [sel_entity]
			VAR _p = [sel_project_id]
			VAR _r = [sel_role_id]
			VAR _pt =
			    SELECTCOLUMNS(
			        FILTER( ALL( tbl_project_tool ), _e = "project" && tbl_project_tool[project_id] = _p ),
			        "@tool_id", tbl_project_tool[tool_id],
			        "@rel", tbl_project_tool[context_relevance_level]
			    )
			VAR _rt =
			    SELECTCOLUMNS(
			        FILTER( ALL( tbl_role_tool ), _e = "role" && tbl_role_tool[role_id] = _r ),
			        "@tool_id", tbl_role_tool[tool_id],
			        "@rel", tbl_role_tool[context_relevance_level]
			    )
			VAR _top = TOPN( 5, UNION( _pt, _rt ), [@rel], DESC, [@tool_id], ASC )
			VAR _named =
			    ADDCOLUMNS(
			        _top,
			        "@label",
			            VAR _t = [@tool_id]
			            VAR _name = CALCULATE( SELECTEDVALUE( tbl_tools[tool_display_name] ), REMOVEFILTERS( tbl_tools ), tbl_tools[tool_id] = _t )
			            VAR _lvl = CALCULATE( SELECTEDVALUE( tbl_tools[overall_proficiency_level] ), REMOVEFILTERS( tbl_tools ), tbl_tools[tool_id] = _t )
			            RETURN IF( ISBLANK( _lvl ), _name, _name & " [" & FORMAT( _lvl, "0" ) & "/7]" )
			    )
			RETURN
			    IF(
			        NOT ISBLANK( [sel_override_text] ),
			        "",
			        CONCATENATEX( _named, [@label], "   •   ", [@rel], DESC, [@tool_id], ASC ) & ""
			    )
		lineageTag: fee83f9e-4565-4cb4-855a-75f23aa989e8

	measure sel_highlight =
			VAR _p = [sel_project_id]
			VAR _r = [sel_role_id]
			VAR _text =
			    SWITCH(
			        [sel_entity],
			        "project", CALCULATE( SELECTEDVALUE( tbl_projects[project_summary_short] ), REMOVEFILTERS( tbl_projects ), tbl_projects[project_id] = _p ),
			        "role",    CALCULATE( SELECTEDVALUE( tbl_roles[role_summary_short] ),      REMOVEFILTERS( tbl_roles ),    tbl_roles[role_id] = _r )
			    )
			RETURN IF( NOT ISBLANK( [sel_override_text] ), "", _text & "" )
		lineageTag: 1b42f4cd-da9d-4002-8cb5-fe9ca65c92b6

	measure sel_radar_svg =
			VAR _e = [sel_entity]
			VAR _p = [sel_project_id]
			VAR _r = [sel_role_id]
			VAR _override = [sel_override_text]
			VAR _ps =
			    SELECTCOLUMNS(
			        FILTER( ALL( tbl_project_skill ), _e = "project" && tbl_project_skill[project_id] = _p ),
			        "@skill_id", tbl_project_skill[skill_id],
			        "@rel", tbl_project_skill[context_relevance_level]
			    )
			VAR _rs =
			    SELECTCOLUMNS(
			        FILTER( ALL( tbl_role_skill ), _e = "role" && tbl_role_skill[role_id] = _r ),
			        "@skill_id", tbl_role_skill[skill_id],
			        "@rel", tbl_role_skill[context_relevance_level]
			    )
			VAR _meta =
			    ADDCOLUMNS(
			        FILTER( UNION( _ps, _rs ), NOT ISBLANK( [@rel] ) ),
			        "@group",
			            VAR _s = [@skill_id]
			            RETURN CALCULATE( SELECTEDVALUE( tbl_skills[skill_group] ), REMOVEFILTERS( tbl_skills ), tbl_skills[skill_id] = _s ),
			        "@name",
			            VAR _s = [@skill_id]
			            RETURN CALCULATE( SELECTEDVALUE( tbl_skills[skill_name] ), REMOVEFILTERS( tbl_skills ), tbl_skills[skill_id] = _s )
			    )
			VAR _tech = TOPN( 4, FILTER( _meta, [@group] = "Technical" ), [@rel], DESC, [@skill_id], ASC )
			VAR _soft = TOPN( 4, FILTER( _meta, [@group] = "Soft" ), [@rel], DESC, [@skill_id], ASC )
			VAR _keyed =
			    ADDCOLUMNS(
			        UNION( _tech, _soft ),
			        "@key", IF( [@group] = "Technical", 0, 1 ) * 100000
			                + ( 7 - [@rel] ) * 1000
			                + [@skill_id]
			    )
			VAR _n = COUNTROWS( _keyed )
			VAR _cx = 260
			VAR _cy = 196
			VAR _r0 = 105
			VAR _geo =
			    ADDCOLUMNS(
			        _keyed,
			        "@i",
			            VAR _k = [@key]
			            RETURN COALESCE( COUNTROWS( FILTER( _keyed, [@key] < _k ) ), 0 )
			    )
			VAR _ang = ADDCOLUMNS( _geo, "@a", -PI() / 2 + [@i] * 2 * PI() / _n )
			VAR _pts =
			    ADDCOLUMNS(
			        _ang,
			        "@x",  _cx + _r0 * ( [@rel] - 1 ) / 6 * COS( [@a] ),
			        "@y",  _cy + _r0 * ( [@rel] - 1 ) / 6 * SIN( [@a] ),
			        "@sx", _cx + _r0 * COS( [@a] ),
			        "@sy", _cy + _r0 * SIN( [@a] ),
			        "@lx", _cx + ( _r0 + 17 ) * COS( [@a] ),
			        "@ly", _cy + ( _r0 + 17 ) * SIN( [@a] )
			    )
			VAR _ticks = SELECTCOLUMNS( GENERATESERIES( 2, 7, 1 ), "@t", [Value] )
			VAR _rings =
			    CONCATENATEX(
			        _ticks,
			        VAR _rr = _r0 * ( [@t] - 1 ) / 6
			        VAR _rp =
			            CONCATENATEX(
			                _pts,
			                FORMAT( ROUND( _cx + _rr * COS( [@a] ), 0 ), "0" ) & ","
			                    & FORMAT( ROUND( _cy + _rr * SIN( [@a] ), 0 ), "0" ),
			                " ", [@i], ASC
			            )
			        RETURN
			            "<polygon points=""" & _rp & """ fill=""none"" stroke="""
			                & IF( [@t] = 7, "rgb(200,200,200)", "rgb(224,224,224)" )
			                & """ stroke-width=""1""/>",
			        ""
			    )
			VAR _spokes =
			    CONCATENATEX(
			        _pts,
			        "<line x1=""" & FORMAT( _cx, "0" ) & """ y1=""" & FORMAT( _cy, "0" )
			            & """ x2=""" & FORMAT( ROUND( [@sx], 0 ), "0" )
			            & """ y2=""" & FORMAT( ROUND( [@sy], 0 ), "0" )
			            & """ stroke=""rgb(224,224,224)"" stroke-width=""1""/>",
			        ""
			    )
			VAR _poly =
			    CONCATENATEX(
			        _pts,
			        FORMAT( ROUND( [@x], 0 ), "0" ) & "," & FORMAT( ROUND( [@y], 0 ), "0" ),
			        " ", [@i], ASC
			    )
			VAR _dots =
			    CONCATENATEX(
			        _pts,
			        "<circle cx=""" & FORMAT( ROUND( [@x], 0 ), "0" )
			            & """ cy=""" & FORMAT( ROUND( [@y], 0 ), "0" )
			            & """ r=""3"" fill=""rgb(16,124,65)""/>",
			        ""
			    )
			VAR _labels =
			    CONCATENATEX(
			        _pts,
			        VAR _raw = [@name]
			        VAR _len = LEN( _raw )
			        VAR _spaces = FILTER( GENERATESERIES( 1, _len, 1 ), MID( _raw, [Value], 1 ) = " " )
			        VAR _split =
			            IF(
			                _len <= 20 || ISEMPTY( _spaces ),
			                0,
			                MINX( TOPN( 1, _spaces, ABS( [Value] - _len / 2 ), ASC ), [Value] )
			            )
			        VAR _lx = ROUND( [@lx], 0 )
			        VAR _ly = ROUND( [@ly], 0 )
			        VAR _anchor =
			            IF( ABS( _lx - _cx ) > 4, IF( _lx > _cx, "start", "end" ), "middle" )
			        VAR _dy = IF( ABS( _ly - _cy ) > _r0, IF( _ly > _cy, 10, -3 ), 4 )
			        VAR _y0 = ROUND( _ly + _dy, 0 ) - IF( _split > 0, 5, 0 )
			        VAR _l1 = IF( _split = 0, _raw, TRIM( LEFT( _raw, _split - 1 ) ) )
			        VAR _l2 = IF( _split = 0, "", TRIM( MID( _raw, _split + 1, _len ) ) )
			        VAR _body =
			            IF(
			                _split = 0,
			                SUBSTITUTE( SUBSTITUTE( _l1, "&", "&amp;" ), "<", "&lt;" ),
			                "<tspan x=""" & FORMAT( _lx, "0" ) & """ dy=""0"">"
			                    & SUBSTITUTE( SUBSTITUTE( _l1, "&", "&amp;" ), "<", "&lt;" ) & "</tspan>"
			                    & "<tspan x=""" & FORMAT( _lx, "0" ) & """ dy=""11"">"
			                    & SUBSTITUTE( SUBSTITUTE( _l2, "&", "&amp;" ), "<", "&lt;" ) & "</tspan>"
			            )
			        RETURN
			            "<text x=""" & FORMAT( _lx, "0" ) & """ y=""" & FORMAT( _y0, "0" )
			                & """ text-anchor=""" & _anchor
			                & """ font-family=""Segoe UI, Arial, sans-serif"" font-size=""10"""
			                & " fill=""rgb(66,66,66)"">" & _body & "</text>",
			        ""
			    )
			VAR _empty =
			    "data:image/svg+xml;utf8,<svg xmlns=""http://www.w3.org/2000/svg"" "
			        & "viewBox=""0 0 4 4"" width=""4"" height=""4""></svg>"
			RETURN
			    IF(
			        NOT ISBLANK( _override ) || ISBLANK( _n ) || _n < 3,
			        _empty,
			        "data:image/svg+xml;utf8,<svg xmlns=""http://www.w3.org/2000/svg"" "
			            & "viewBox=""21 45 478 304"" width=""478"" height=""304"">"
			            & _rings & _spokes
			            & "<polygon points=""" & _poly & """ fill=""rgb(16,124,65)"" "
			            & "fill-opacity=""0.14"" stroke=""rgb(16,124,65)"" stroke-width=""1.75"" "
			            & "stroke-linejoin=""round""/>"
			            & _dots & _labels
			            & "</svg>"
			    )
		lineageTag: ed1aa6bd-29f0-491c-8f31-5238dd36374e
		dataCategory: ImageUrl

