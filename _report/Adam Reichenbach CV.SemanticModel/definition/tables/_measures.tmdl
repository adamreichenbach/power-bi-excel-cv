	measure exp_key_facts =
			VAR _row_skill = SELECTEDVALUE( tbl_role_perspective_rows[skill_id] )
			VAR _skill_row_dropped =
			    NOT ISBLANK( _row_skill )
			        && ISFILTERED( tbl_skills[skill_name] )
			        && NOT _row_skill IN VALUES( tbl_skills[skill_id] )
			RETURN
			IF(
			    _skill_row_dropped,
			    BLANK(),
			    CALCULATE(
			        VAR _perspective = SELECTEDVALUE( tbl_perspectives[perspective_id] )
			        VAR _period      = SELECTEDVALUE( tbl_role_perspective_rows[role_period] )
			        VAR _industry    = SELECTEDVALUE( tbl_role_perspective_rows[role_industry_name] )
			        VAR _function    = SELECTEDVALUE( tbl_role_perspective_rows[role_function_name] )
			        VAR _industry_is_the_grouping = _perspective = 3
			        RETURN
			            IF(
			                ISBLANK( _period ),
			                BLANK(),
			                _period
			                    & IF(
			                        _industry_is_the_grouping || ISBLANK( _industry ),
			                        "",
			                        "  ·  " & _industry
			                      )
			                    & IF( ISBLANK( _function ), "", "  ·  " & _function )
			            ),
			        CROSSFILTER( tbl_role_skill[role_id], tbl_roles[role_id], Both ),
			        CROSSFILTER( tbl_role_tool[role_id],  tbl_roles[role_id], Both )
			    )
			)
		lineageTag: f1c0564b-e80f-4734-9405-0fd9c4a4cfa9

	measure exp_body_text =
			VAR _view   = SELECTEDVALUE( tbl_view_modes[mode], "Story" )
			VAR _detail = SELECTEDVALUE( tbl_detail_levels[mode], "Standard" )
			VAR _row_skill = SELECTEDVALUE( tbl_role_perspective_rows[skill_id] )
			VAR _skill_row_dropped =
			    NOT ISBLANK( _row_skill )
			        && ISFILTERED( tbl_skills[skill_name] )
			        && NOT _row_skill IN VALUES( tbl_skills[skill_id] )
			RETURN
			IF(
			    _skill_row_dropped,
			    BLANK(),
			    CALCULATE(
			        CALCULATE(
			            SELECTEDVALUE( tbl_role_content[text] ),
			            TREATAS( VALUES( tbl_role_perspective_rows[role_id] ), tbl_roles[role_id] ),
			            tbl_role_content[view] = _view,
			            tbl_role_content[detail_level] = _detail
			        ),
			        CROSSFILTER( tbl_role_skill[role_id], tbl_roles[role_id], Both ),
			        CROSSFILTER( tbl_role_tool[role_id],  tbl_roles[role_id], Both )
			    )
			)
