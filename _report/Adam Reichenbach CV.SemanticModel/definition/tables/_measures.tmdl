		lineageTag: 6d1b4a69-5c6e-4d2b-a013-31055a4b9995

	measure skills_total_count = COUNTROWS( ALL( tbl_skills ) )
		formatString: 0
		lineageTag: de3fd157-ea34-4af6-bc77-8e5db77883cf

	measure skills_type = IF( [skills_in_scope] = 1, SELECTEDVALUE( tbl_skills[skill_group] ) )
		lineageTag: 183d97ed-173c-4398-a411-fdd1924fc75f

	measure skills_count_label = [skills_visible_count] & " of " & [skills_total_count] & " skills"
		lineageTag: 7a8c2fe2-ebb0-4f54-bd9b-8d1ad1e518e7

	measure fbar_filter_template =
			VAR _f = IF( ISFILTERED( tbl_functions[function_name] ), "COUNTIF(FunctionPick,{T}[Function])" )
			VAR _i = IF( ISFILTERED( tbl_industries[industry_group] ), "COUNTIF(IndustryPick,{T}[Industry])" )
			VAR _s = IF( ISFILTERED( tbl_skills[skill_name] ), "COUNTIF(SkillPick,{T}[Skill])" )
			VAR _t = IF( ISFILTERED( tbl_tools[tool_display_name] ), "COUNTIF(ToolPick,{T}[Tool])" )
			RETURN
			    CONCATENATEX(
			        FILTER( { ( 1, _f ), ( 2, _i ), ( 3, _s ), ( 4, _t ) }, NOT ISBLANK( [Value2] ) ),
			        [Value2],
			        " * ",
			        [Value1], ASC
			    )
		lineageTag: afd8305d-61a4-489d-a51f-32c0ab6f9b94

	measure fbar_selected_name =
			VAR _sheet = SELECTEDVALUE( tbl_sheet_tabs[sheet_tab_id], 1 )
			RETURN
			    SWITCH(
			        _sheet,
			        2,
			            IF(
			                ISFILTERED( tbl_role_perspective_rows[role_identity] )
			                    && HASONEVALUE( tbl_role_perspective_rows[role_id] )
			                    && NOT ISBLANK( [exp_key_facts] ),
			                LOOKUPVALUE( tbl_roles[role_title], tbl_roles[role_id], SELECTEDVALUE( tbl_role_perspective_rows[role_id] ) )
			            ),
			        3,
			            IF(
			                ISFILTERED( tbl_project_perspective_rows[project_identity] )
			                    && HASONEVALUE( tbl_project_perspective_rows[project_id] )
			                    && NOT ISBLANK( [prj_key_facts] ),
			                LOOKUPVALUE( tbl_projects[project_name], tbl_projects[project_id], SELECTEDVALUE( tbl_project_perspective_rows[project_id] ) )
			            ),
			        4,
			            IF(
			                ISFILTERED( tbl_tools[tool_row_label] )
			                    && HASONEVALUE( tbl_tools[tool_id] )
			                    && [tech_in_scope] = 1,
			                SELECTEDVALUE( tbl_tools[tool_display_name] )
			            ),
			        7,
			            IF(
			                ISFILTERED( tbl_skills[skill_row_label] )
			                    && HASONEVALUE( tbl_skills[skill_id] )
			                    && [skills_in_scope] = 1,
			                SELECTEDVALUE( tbl_skills[skill_name] )
			            )
			    )
		lineageTag: 598b5267-13cd-492f-b45c-5533c081ed7c

	measure status_bar_text =
			VAR _sheet = SELECTEDVALUE( tbl_sheet_tabs[sheet_tab_id], 1 )
			VAR _gap = REPT( UNICHAR( 160 ), 8 )
			VAR _tool_avg =
			    AVERAGEX(
			        FILTER( VALUES( tbl_tools[tool_id] ), [tech_in_scope] = 1 ),
			        CALCULATE( SELECTEDVALUE( tbl_tools[overall_proficiency_level] ) )
			    )
			VAR _skill_avg =
			    AVERAGEX(
			        FILTER( VALUES( tbl_skills[skill_id] ), [skills_in_scope] = 1 ),
			        CALCULATE( SELECTEDVALUE( tbl_skills[overall_proficiency_level] ) )
			    )
			VAR _text =
			    SWITCH(
			        _sheet,
			        2, "Count: " & [exp_visible_count],
			        3, "Count: " & [prj_visible_count],
			        4, IF( ISBLANK( _tool_avg ), "", "Average: " & FORMAT( _tool_avg, "0.0" ) & _gap ) & "Count: " & [tech_visible_count],
			        5, "Count: " & COUNTROWS( tbl_education ),
			        6, "Count: " & COUNTROWS( tbl_additional_items ),
			        7, IF( ISBLANK( _skill_avg ), "", "Average: " & FORMAT( _skill_avg, "0.0" ) & _gap ) & "Count: " & [skills_visible_count]
			    )
			RETURN _text & ""
		lineageTag: 5f65f2d8-0541-4e6a-a68b-e77ed046d7dc

	measure exec_hl_additional_id =
			MAXX(
			    TOPN(
			        1,
			        FILTER( ALL( tbl_additional ), tbl_additional[is_highlight] = TRUE() ),
			        tbl_additional[from_year], DESC,
			        tbl_additional[additional_id], ASC
			    ),
			    tbl_additional[additional_id]
			)
		formatString: 0
		lineageTag: 6a6ffb6a-3253-434c-a223-9ad63a28f68a

	measure exec_hl_title =
			VAR _id = [exec_hl_additional_id]
			RETURN
			    IF(
			        ISBLANK( _id ),
			        "",
			        LOOKUPVALUE( tbl_additional[title], tbl_additional[additional_id], _id )
			            & "  ·  "
			            & LOOKUPVALUE( tbl_additional[from_year], tbl_additional[additional_id], _id )
			    )
		lineageTag: ab28fda8-9312-46fa-8971-241825fc8df7

	measure exec_hl_detail =
			VAR _id = [exec_hl_additional_id]
			RETURN LOOKUPVALUE( tbl_additional[detail], tbl_additional[additional_id], _id ) & ""
		lineageTag: 237645f3-282d-4ae7-9a3f-ea6c124b3297

	measure exec_hl_url =
			VAR _id = [exec_hl_additional_id]
