			RETURN
			    IF(
			        [tech_in_scope] = 1 && NOT ISBLANK( _level ),
			        FORMAT( _level, "0" ) & "/7"
			    )
		lineageTag: aae9dd49-3159-4186-9f89-99c76a16cca9

	measure tech_usage =
			VAR _tool = SELECTEDVALUE( tbl_tools[tool_id] )
			VAR _role_ids =
			    DISTINCT( SELECTCOLUMNS( FILTER( ALL( tbl_role_tool ), tbl_role_tool[tool_id] = _tool ), "@id", tbl_role_tool[role_id] ) )
			VAR _project_ids =
			    DISTINCT( SELECTCOLUMNS( FILTER( ALL( tbl_project_tool ), tbl_project_tool[tool_id] = _tool ), "@id", tbl_project_tool[project_id] ) )
			VAR _periods =
			    UNION(
			        SELECTCOLUMNS(
			            FILTER( ALL( tbl_roles ), tbl_roles[role_id] IN _role_ids ),
			            "@from", tbl_roles[from_month_code],
			            "@to", tbl_roles[to_month_code_clamped]
			        ),
			        SELECTCOLUMNS(
			            FILTER( ALL( tbl_projects ), tbl_projects[project_id] IN _project_ids ),
			            "@from", tbl_projects[from_month_code],
			            "@to", tbl_projects[to_month_code_clamped]
			        )
			    )
			VAR _months =
			    COUNTROWS(
			        FILTER(
			            ALL( dim_calendar[year_month] ),
			            VAR _m = dim_calendar[year_month]
			            RETURN NOT ISEMPTY( FILTER( _periods, [@from] <= _m && [@to] >= _m ) )
			        )
			    )
			VAR _years = QUOTIENT( _months, 12 )
			VAR _rest = MOD( _months, 12 )
			VAR _duration =
			    IF( _years > 0, _years & IF( _years = 1, " year", " years" ), "" )
			        & IF( _years > 0 && _rest > 0, " ", "" )
			        & IF( _rest > 0, _rest & IF( _rest = 1, " month", " months" ), "" )
			VAR _role_n = COUNTROWS( _role_ids )
			VAR _project_n = COUNTROWS( _project_ids )
			VAR _roles = IF( _role_n > 0, _role_n & IF( _role_n = 1, " role", " roles" ) )
			VAR _projects = IF( _project_n > 0, _project_n & IF( _project_n = 1, " project", " projects" ) )
			VAR _a = IF( LEN( _duration ) = 0, _roles, IF( ISBLANK( _roles ), _duration, _duration & "  ·  " & _roles ) )
			VAR _b = IF( LEN( _a ) = 0, _projects, IF( ISBLANK( _projects ), _a, _a & "  ·  " & _projects ) )
			RETURN
			    IF( [tech_in_scope] = 1 && LEN( _b ) > 0, _b )
		lineageTag: 6aacad04-493c-4b87-8467-b19dda112da4

